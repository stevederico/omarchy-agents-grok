#!/usr/bin/python3
# omarchy:summary=Print the Grok usage record as JSON
# omarchy:args=[--force] [--limits-only]
# omarchy:hidden=true
"""Collect Grok CLI usage into one display-ready JSON record.

Token stats come from turn_completed events in ~/.grok/sessions. The weekly
credit allowance and plan come from the billing endpoint the CLI itself
calls, falling back to the credits reading grok writes to its log. The
agents panel only ever reads the JSON this prints.
"""

from __future__ import annotations

import argparse
import datetime as dt
import fcntl
import hashlib
import json
import os
import sys
import tempfile
import time
import urllib.error
import urllib.request
from collections.abc import Iterator
from pathlib import Path
from typing import Any

AGENT_ID = "grok"
AGENT_NAME = "Grok"
AUTH_HELP = "Run `grok` and sign in."
DEFAULT_PROXY_BASE_URL = "https://cli-chat-proxy.grok.com/v1"
LIVE_TIMEOUT_SECONDS = 4
SCAN_REUSE_SECONDS = 20
LIMITS_ONLY_REUSE_SECONDS = 900
CREDITS_MARKER = b'"billing: fetched credits config"'
LOG_CHUNK_BYTES = 256 * 1024
LOG_SCAN_LIMIT_BYTES = 8 * 1024 * 1024


def grok_home() -> Path:
  return Path(os.environ.get("GROK_HOME") or (Path.home() / ".grok")).expanduser()


def usage_dir() -> Path:
  root = Path(os.environ.get("XDG_STATE_HOME") or (Path.home() / ".local" / "state"))
  return root / "omarchy" / "agents" / "usage"


def proxy_base() -> str:
  return (os.environ.get("GROK_CLI_CHAT_PROXY_BASE_URL") or DEFAULT_PROXY_BASE_URL).rstrip("/")


def cache_root() -> Path:
  root = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "omarchy" / "agent-usage"
  root.mkdir(parents=True, exist_ok=True)
  return root


def number(value: Any) -> int:
  try:
    n = float(value or 0)
    return max(0, round(n) if n == n else 0)
  except (TypeError, ValueError):
    return 0


def date_string(value: dt.date) -> str:
  return value.strftime("%Y-%m-%d")


def local_date_string() -> str:
  return date_string(dt.datetime.now().date())


def recent_date_strings(today: str | None = None) -> list[str]:
  start = dt.date.fromisoformat(today) if today else dt.datetime.now().date()
  return [date_string(start - dt.timedelta(days=offset)) for offset in range(6, -1, -1)]


def parse_iso(value: Any) -> dt.datetime | None:
  text = str(value or "").strip()
  if text == "":
    return None
  try:
    parsed = dt.datetime.fromisoformat(text.replace("Z", "+00:00"))
  except ValueError:
    return None
  return parsed if parsed.tzinfo is not None else parsed.replace(tzinfo=dt.timezone.utc)


def local_date_from_timestamp(value: Any) -> str:
  if value is None:
    return local_date_string()
  if isinstance(value, (int, float)):
    try:
      seconds = float(value) / 1000.0 if float(value) > 10_000_000_000 else float(value)
      return date_string(dt.datetime.fromtimestamp(seconds).date())
    except (OverflowError, OSError, ValueError):
      return local_date_string()
  parsed = parse_iso(value)
  if parsed is None:
    return local_date_string()
  return date_string(parsed.astimezone().date())


def empty_bucket() -> dict[str, int]:
  return {
    "inputTokens": 0,
    "outputTokens": 0,
    "cacheReadInputTokens": 0,
    "cacheCreationInputTokens": 0,
  }


def empty_stats(today: str | None = None) -> dict[str, Any]:
  return {
    "todayPrompts": 0,
    "todaySessions": 0,
    "todayTotalTokens": 0,
    "todayTokensByModel": {},
    "recentDays": [{"date": day, "messageCount": 0} for day in recent_date_strings(today)],
    "totalPrompts": 0,
    "totalSessions": 0,
    "activeDays": 0,
    "activeDates": [],
    "modelUsage": {},
  }


def write_json(path: Path, payload: Any) -> None:
  path.parent.mkdir(parents=True, exist_ok=True)
  handle_fd, tmp_name = tempfile.mkstemp(dir=path.parent, prefix=path.name + ".", suffix=".tmp")
  tmp = Path(tmp_name)
  try:
    with os.fdopen(handle_fd, "w", encoding="utf-8") as handle:
      handle.write(json.dumps(payload, separators=(",", ":")) + "\n")
    tmp.chmod(0o644)
    tmp.replace(path)
  except BaseException:
    tmp.unlink(missing_ok=True)
    raise


def read_json(path: Path) -> Any:
  return json.loads(path.read_text(encoding="utf-8"))


# ---------------------------------------------------------------- local scan


def model_name(raw: Any) -> str:
  value = str(raw or "grok").strip() or "grok"
  return value.rstrip("/").split("/")[-1]


def session_kind(session_dir: Path) -> str:
  try:
    data = read_json(session_dir / "summary.json")
  except (OSError, json.JSONDecodeError):
    return ""
  if not isinstance(data, dict):
    return ""
  return str(data.get("session_kind") or "")


def split_tokens(stats: dict[str, Any]) -> tuple[int, int, int, int]:
  # Grok folds cache counters into inputTokens. Subtract them so the four
  # panel buckets stay mutually exclusive, the same way Codex does.
  cache_read = number(stats.get("cachedReadTokens") or stats.get("cacheReadInputTokens"))
  cache_creation = number(stats.get("cacheCreationTokens") or stats.get("cacheCreationInputTokens"))
  input_tokens = max(0, number(stats.get("inputTokens")) - cache_read - cache_creation)
  output_tokens = number(stats.get("outputTokens"))
  return input_tokens, output_tokens, cache_read, cache_creation


def turn_models(usage: dict[str, Any], fallback_model: Any = None) -> list[tuple[str, int, int, int, int]]:
  models = usage.get("modelUsage")
  per_model: list[tuple[str, int, int, int, int]] = []
  if isinstance(models, dict) and models:
    for model, stats in models.items():
      if not isinstance(stats, dict):
        continue
      input_tokens, output_tokens, cache_read, cache_creation = split_tokens(stats)
      if input_tokens or output_tokens or cache_read or cache_creation:
        per_model.append((model_name(model), input_tokens, output_tokens, cache_read, cache_creation))
  if per_model:
    return per_model
  input_tokens, output_tokens, cache_read, cache_creation = split_tokens(usage)
  if input_tokens or output_tokens or cache_read or cache_creation:
    return [(model_name(fallback_model or usage.get("model") or usage.get("modelId")), input_tokens, output_tokens, cache_read, cache_creation)]
  return []


class SessionUsage:
  def __init__(self, today: str | None = None):
    self.today = today or local_date_string()
    self.recent_dates = recent_date_strings(self.today)
    self.recent = {day: 0 for day in self.recent_dates}
    self.today_tokens_by_model: dict[str, int] = {}
    self.model_usage: dict[str, dict[str, int]] = {}
    self.today_sessions: set[str] = set()
    self.today_prompts = 0
    self.today_total_tokens = 0
    self.total_prompts = 0
    self.total_sessions: set[str] = set()
    self.active_days: set[str] = set()
    self.seen_turns: set[str] = set()

  def add_turn(self, day: str, session_key: str, per_model: list[tuple[str, int, int, int, int]]) -> None:
    # One completed turn is one prompt, however many models answered it.
    self.total_prompts += 1
    self.total_sessions.add(session_key)
    self.active_days.add(day)

    turn_total = 0
    for model, input_tokens, output_tokens, cache_read, cache_creation in per_model:
      bucket = self.model_usage.setdefault(model, empty_bucket())
      bucket["inputTokens"] += input_tokens
      bucket["outputTokens"] += output_tokens
      bucket["cacheReadInputTokens"] += cache_read
      bucket["cacheCreationInputTokens"] += cache_creation
      model_total = input_tokens + output_tokens + cache_read + cache_creation
      turn_total += model_total
      if day == self.today:
        self.today_tokens_by_model[model] = self.today_tokens_by_model.get(model, 0) + model_total

    if day in self.recent:
      self.recent[day] += turn_total
    if day == self.today:
      self.today_prompts += 1
      self.today_sessions.add(session_key)
      self.today_total_tokens += turn_total

  def stats(self) -> dict[str, Any]:
    return {
      "todayPrompts": self.today_prompts,
      "todaySessions": len(self.today_sessions),
      "todayTotalTokens": self.today_total_tokens,
      "todayTokensByModel": self.today_tokens_by_model,
      "recentDays": [{"date": day, "messageCount": self.recent[day]} for day in self.recent_dates],
      "totalPrompts": self.total_prompts,
      "totalSessions": len(self.total_sessions),
      "activeDays": len(self.active_days),
      "activeDates": sorted(self.active_days),
      "modelUsage": self.model_usage,
    }


def scan_updates_file(path: Path, usage: SessionUsage) -> None:
  session_key = path.parent.name
  try:
    with path.open("r", encoding="utf-8", errors="replace") as handle:
      for raw in handle:
        if '"usage"' not in raw or "turn_completed" not in raw:
          continue
        try:
          entry = json.loads(raw)
        except json.JSONDecodeError:
          continue
        if not isinstance(entry, dict):
          continue
        params = entry.get("params") if isinstance(entry.get("params"), dict) else {}
        update = params.get("update") if isinstance(params.get("update"), dict) else {}
        if update.get("sessionUpdate") != "turn_completed":
          continue
        usage_payload = update.get("usage")
        if not isinstance(usage_payload, dict):
          continue

        prompt_id = str(update.get("prompt_id") or "")
        turn_key = f"{session_key}:{prompt_id}" if prompt_id else ""
        if turn_key and turn_key in usage.seen_turns:
          continue

        per_model = turn_models(usage_payload, update.get("model"))
        if not per_model:
          continue
        if turn_key:
          usage.seen_turns.add(turn_key)
        usage.add_turn(local_date_from_timestamp(entry.get("timestamp")), session_key, per_model)
  except OSError:
    return


def scan_sessions(home: Path, today: str | None = None) -> dict[str, Any]:
  usage = SessionUsage(today)
  root = home / "sessions"
  if not root.is_dir():
    return usage.stats()

  for path in root.rglob("updates.jsonl"):
    if not path.is_file():
      continue
    if session_kind(path.parent) == "subagent_fork":
      continue
    scan_updates_file(path, usage)
  return usage.stats()


def scan_cache_paths(home: Path) -> tuple[Path, Path]:
  digest = hashlib.sha1(str(home).encode("utf-8")).hexdigest()[:16]
  root = cache_root()
  return root / f"grok-scan-{digest}.json", root / f"grok-scan-{digest}.lock"


def read_fresh_scan(cache_file: Path, max_age: float, today: str) -> dict[str, Any] | None:
  if max_age <= 0 or not cache_file.exists():
    return None
  try:
    age = time.time() - cache_file.stat().st_mtime
    if age < 0 or age > max_age:
      return None
    cached = read_json(cache_file)
  except Exception:
    return None
  if not isinstance(cached, dict) or cached.get("schemaVersion") != 1 or cached.get("scanDate") != today:
    return None
  stats = cached.get("stats")
  return stats if isinstance(stats, dict) else None


def cached_scan(home: Path, max_age: float) -> dict[str, Any]:
  today = local_date_string()
  try:
    cache_file, lock_file = scan_cache_paths(home)
  except Exception as exc:
    print(f"omarchy-agent-usage-grok: cache unavailable ({exc}); scanning directly", file=sys.stderr)
    return scan_sessions(home, today)

  cached = read_fresh_scan(cache_file, max_age, today)
  if cached is not None:
    return cached

  try:
    lock_file.parent.mkdir(parents=True, exist_ok=True)
    with lock_file.open("w") as lock:
      fcntl.flock(lock, fcntl.LOCK_EX)
      cached = read_fresh_scan(cache_file, max_age, today)
      if cached is not None:
        return cached
      stats = scan_sessions(home, today)
      try:
        write_json(cache_file, {"schemaVersion": 1, "scanDate": today, "stats": stats})
      except Exception as exc:
        print(f"omarchy-agent-usage-grok: could not write usage cache ({exc})", file=sys.stderr)
      return stats
  except Exception as exc:
    print(f"omarchy-agent-usage-grok: cache unavailable ({exc}); scanning directly", file=sys.stderr)
    return scan_sessions(home, today)


# ------------------------------------------------------------------- limits


def log_path(home: Path) -> Path:
  configured = os.environ.get("GROK_LOG_FILE")
  return Path(configured) if configured else home / "logs" / "unified.jsonl"


def credits_records(home: Path) -> Iterator[dict[str, Any]]:
  """Every logged credits reading, newest first."""
  path = log_path(home)
  try:
    size = path.stat().st_size
  except OSError:
    return

  position = size
  scanned = 0
  partial = b""
  try:
    with path.open("rb") as handle:
      while position > 0 and scanned < LOG_SCAN_LIMIT_BYTES:
        step = min(LOG_CHUNK_BYTES, position)
        position -= step
        scanned += step
        handle.seek(position)
        lines = (handle.read(step) + partial).split(b"\n")
        partial = lines.pop(0) if position > 0 else b""
        for raw in reversed(lines):
          if CREDITS_MARKER not in raw:
            continue
          try:
            record = json.loads(raw)
          except json.JSONDecodeError:
            continue
          if isinstance(record, dict):
            yield record
  except OSError:
    return


def period_label(raw: Any, start: dt.datetime | None, end: dt.datetime | None) -> str:
  kind = str(raw or "").upper().replace("USAGE_PERIOD_TYPE_", "")
  if kind == "WEEKLY":
    return "Weekly (7-day)"
  if kind == "MONTHLY":
    return "Monthly"
  if kind == "DAILY":
    return "Daily"
  if start is None or end is None:
    return "Weekly (7-day)"
  days = max(1, round((end - start).total_seconds() / 86400))
  if days == 7:
    return "Weekly (7-day)"
  if days in (30, 31):
    return "Monthly"
  return f"{days}-day window"


def limit_from_config(config: Any) -> dict[str, Any] | None:
  if not isinstance(config, dict):
    return None

  percent = config.get("creditUsagePercent")
  period = config.get("currentPeriod") if isinstance(config.get("currentPeriod"), dict) else {}
  start = parse_iso(period.get("start") or config.get("billingPeriodStart"))
  end = parse_iso(period.get("end") or config.get("billingPeriodEnd"))
  # SuperGrok bodies often carry the current window and no percentage at all.
  # That is not a meter of 0 — it is no meter.
  if percent is None or start is None or end is None:
    return None

  now = dt.datetime.now(dt.timezone.utc)
  if not (start <= now <= end):
    return None

  try:
    fraction = float(percent) / 100.0
  except (TypeError, ValueError):
    return None
  if fraction != fraction or fraction < 0:
    return None

  return {
    "label": period_label(period.get("type"), start, end),
    "percent": max(0.0, min(1.0, fraction)),
    "resetsAt": end.isoformat(),
  }


def cached_token(home: Path) -> str:
  # grok refreshes this token itself. Reading an expired one would only buy a
  # 401, and minting a new one is the CLI's job.
  try:
    entries = read_json(home / "auth.json")
  except (OSError, ValueError):
    return ""
  if not isinstance(entries, dict):
    return ""

  now = dt.datetime.now(dt.timezone.utc)
  preferred = ""
  fallback = ""
  for key, entry in entries.items():
    if not isinstance(entry, dict):
      continue
    token = str(entry.get("key") or "").strip()
    if token == "":
      continue
    expires = parse_iso(entry.get("expires_at"))
    if expires is not None and expires <= now:
      continue
    if str(key).startswith("https://auth.x.ai::"):
      preferred = token
      break
    if fallback == "":
      fallback = token
  return preferred or fallback


def fetch_live_config(token: str) -> dict[str, Any] | None:
  request = urllib.request.Request(
    proxy_base() + "/billing?format=credits",
    headers={"Authorization": "Bearer " + token, "Accept": "application/json"},
  )
  try:
    with urllib.request.urlopen(request, timeout=LIVE_TIMEOUT_SECONDS) as response:
      payload = json.loads(response.read().decode("utf-8", "replace"))
  except (urllib.error.URLError, OSError, ValueError, TimeoutError):
    return None
  config = payload.get("config") if isinstance(payload, dict) else None
  return config if isinstance(config, dict) else None


def logged_credits(home: Path) -> tuple[str, dict[str, Any] | None]:
  """The newest logged tier, and the newest usable limit behind it."""
  tier = ""
  limit = None
  for record in credits_records(home):
    context = record.get("ctx")
    if not isinstance(context, dict):
      continue
    tier = tier or str(context.get("subscriptionTier") or "").strip()
    limit = limit or limit_from_config(context.get("config"))
    if tier and limit:
      break
  return tier, limit


def read_credits(home: Path) -> dict[str, Any]:
  tier, logged_limit = logged_credits(home)
  token = cached_token(home)
  live_limit = limit_from_config(fetch_live_config(token)) if token else None
  # A 200 whose body cannot be read as a meter is just as unusable as a failed
  # call. Prefer a live percentage that still belongs to an open period, then
  # the newest logged reading whose period has not closed.
  return {"tierLabel": tier, "limits": [live_limit or logged_limit] if (live_limit or logged_limit) else []}


# ------------------------------------------------------------------- record


def build_record(stats: dict[str, Any], credits: dict[str, Any], signed_in: bool) -> dict[str, Any]:
  record = {
    "schemaVersion": 1,
    "id": AGENT_ID,
    "name": AGENT_NAME,
    "updatedAt": dt.datetime.now(dt.timezone.utc).isoformat(),
    "ready": number(stats.get("totalPrompts")) > 0 or len(credits["limits"]) > 0,
    "hasLocalStats": True,
    "tierLabel": credits["tierLabel"],
    "limits": credits["limits"],
    "usageStatusText": "",
    "authHelpText": AUTH_HELP,
  }
  if not credits["tierLabel"] and not credits["limits"]:
    record["usageStatusText"] = "Waiting for auth" if not signed_in else "Grok limits unavailable"
  record.update(stats)
  return record


def main() -> int:
  parser = argparse.ArgumentParser(description="Print the Grok usage record as JSON")
  parser.add_argument("--force", action="store_true", help="rescan sessions, ignoring the cache")
  parser.add_argument("--limits-only", action="store_true", help="reuse a recent scan; only the credits probe must be fresh")
  parser.add_argument("--write", action="store_true", help="write grok.json into the agents usage dir")
  args = parser.parse_args()

  home = grok_home()
  max_age = 0 if args.force else (LIMITS_ONLY_REUSE_SECONDS if args.limits_only else SCAN_REUSE_SECONDS)

  try:
    stats = cached_scan(home, max_age)
  except Exception as error:
    print(f"omarchy-agent-usage-grok: {type(error).__name__}", file=sys.stderr)
    stats = empty_stats()

  try:
    credits = read_credits(home)
  except Exception as error:
    print(f"omarchy-agent-usage-grok: {type(error).__name__}", file=sys.stderr)
    credits = {"tierLabel": "", "limits": []}

  record = build_record(stats, credits, signed_in=bool(cached_token(home)))
  if args.write:
    write_json(usage_dir() / "grok.json", record)
  print(json.dumps(record, separators=(",", ":")))
  return 0


if __name__ == "__main__":
  raise SystemExit(main())
